# Groq API Key (FREE, fast)
# Get from: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Google Drive Storage (optional)
# Create a project at: https://console.cloud.google.com
# Enable Google Drive API, create OAuth 2.0 credentials (Web application)
# Add your domain to Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# OneDrive Storage (optional)
# Register app at: https://portal.azure.com > App registrations
# Set redirect URI to your domain, enable "Files.ReadWrite.AppFolder" permission
VITE_ONEDRIVE_CLIENT_ID=your_onedrive_client_id
